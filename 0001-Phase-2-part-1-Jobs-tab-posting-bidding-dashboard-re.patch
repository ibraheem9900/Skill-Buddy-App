+        ) : (
+          <View style={[styles.closedCard, { backgroundColor: c.muted }]}>
+            <Text style={[styles.closedText, { color: c.mutedForeground }]}>Bidding has closed for this job.</Text>
+          </View>
+        )}
+      </ScrollView>
+    </View>
+  );
+}
