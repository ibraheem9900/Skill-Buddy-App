# SkillBuddy — environment variables
#
# This file holds PLACEHOLDERS ONLY. Never commit real values.
# Create the same keys/values in Infisical (Secrets Management > Add New Project
# > drag this file onto the Secrets Overview page to import), then run the app with:
#   infisical run --env=dev -- pnpm --filter @workspace/skillbuddy dev
#
# The app reads these from process.env exactly as before; no code change is needed.

# ---------------------------------------------------------------------------
# Mobile app (artifacts/skillbuddy) — inlined into the JS bundle at build time.
# Anything prefixed EXPO_PUBLIC_ is embedded in the shipped APK and is therefore
# PUBLIC. Never put a real secret behind an EXPO_PUBLIC_ name.
# ---------------------------------------------------------------------------
# Base URL of the live FastAPI backend. Currently hardcoded in
# artifacts/skillbuddy/services/api.ts and read from this variable when set.
EXPO_PUBLIC_API_BASE_URL=https://api.skillbuddy.zeyshan.com

# ---------------------------------------------------------------------------
# Mobile app — public build/serve wiring (optional; defaults are fine)
# ---------------------------------------------------------------------------
# Port for `pnpm run serve` (artifacts/skillbuddy/server/serve.js). Default: 3000
# PORT=3000
# Base path when serving under a sub-path. Default: /
# BASE_PATH=/
# Public host used by scripts/build.js. One of REPLIT_INTERNAL_APP_DOMAIN,
# REPLIT_DEV_DOMAIN or EXPO_PUBLIC_DOMAIN must resolve during a build.
# EXPO_PUBLIC_DOMAIN=
# EXPO_PUBLIC_REPL_ID=

# ---------------------------------------------------------------------------
# Local database library (lib/db, lib/db/drizzle.config.ts) — required, no default.
# ---------------------------------------------------------------------------
# Postgres connection string, e.g. postgres://user:password@host:5432/dbname
DATABASE_URL=

# ---------------------------------------------------------------------------
# API server artifact (artifacts/api-server) — optional
# ---------------------------------------------------------------------------
# pino log level. Default: info
# LOG_LEVEL=info