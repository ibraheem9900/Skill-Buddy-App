{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2020",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmitOnError": true,
    "ignoreDeprecations": "6.0",
    "outDir": "./.out",
    "rootDir": "../..",
    "baseUrl": "../..",
    "paths": { "@/*": ["./*"] },
    "types": [],
    // dom is here ONLY so the geocoding module's plain `fetch`/
    // `URLSearchParams`/`Response` types resolve in this dependency-free
    // harness; it adds no runtime dependency and no React Native types.
    "lib": ["es2020", "dom"]
  },
